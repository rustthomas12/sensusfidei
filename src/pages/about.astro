---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const about = await getEntry('pages', 'about');
const { Content } = await render(about);
---

<BaseLayout
  title="About"
  description="Sensus Fidei is one person's ongoing reflection on faith, philosophy, and daily life."
>
  <article class="wrap about">
    <header class="about__head">
      <p class="section-mark">About</p>
      <h1>{about.data.title}</h1>
    </header>

    <div class="prose about__body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(3rem, 7vw, 5rem);
  }

  .about__head h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .about__body {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }
</style>
