---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListEntry from '../../components/PostListEntry.astro';
import { getCollection } from 'astro:content';
import { sections } from '../../data/sections';

export async function getStaticPaths() {
  return sections.map((s) => ({
    params: { section: s.slug },
    props: { section: s },
  }));
}

const { section } = Astro.props;

const posts = (await getCollection('posts', ({ data }) => data.section === section.slug && !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title={section.name} description={section.description}>
  <section class="section-landing wrap wrap--wide">
    <header class="section-landing__head">
      <p class="section-mark">{section.name}</p>
      <h1>{section.name}</h1>
      <p class="section-landing__desc">{section.description}</p>
    </header>

    <hr class="hairline" />

    {
      posts.length > 0 ? (
        <div class="section-landing__list">
          {posts.map((post) => (
            <PostListEntry
              slug={post.id}
              section={post.data.section}
              title={post.data.title}
              dek={post.data.dek}
              date={post.data.date}
            />
          ))}
        </div>
      ) : (
        <p class="section-landing__empty">Nothing posted here yet. Check back soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .section-landing {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(3rem, 6vw, 4rem);
    padding-left: calc(var(--gutter) + clamp(0rem, 6vw, 3.5rem));
  }

  .section-landing__head {
    max-width: 42rem;
  }

  .section-landing__head h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .section-landing__desc {
    margin-top: 1rem;
    font-size: 1.1rem;
    color: var(--slate);
    max-width: 56ch;
  }

  .section-landing .hairline {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .section-landing__empty {
    padding-block: 2rem;
    color: var(--slate);
    font-style: italic;
  }
</style>
