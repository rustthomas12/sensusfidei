---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <section class="wrap notfound">
    <p class="section-mark">Not found</p>
    <h1>There's nothing at this page.</h1>
    <p class="dek">
      Try the <a href="/">homepage</a>, or browse a section: <a href="/faith/">Faith</a>, <a href="/stewardship/">Stewardship</a>, <a href="/family/">Family</a>, <a href="/culture/">Culture</a>, <a href="/vocation/">Vocation</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 8vw, 5rem);
  }

  .notfound h1 {
    margin-top: 0.5rem;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
  }

  .notfound .dek {
    margin-top: 1rem;
    max-width: 48ch;
    color: var(--slate);
  }

  .notfound .dek a {
    text-decoration: underline;
    text-decoration-color: var(--vellum-line);
  }
</style>
