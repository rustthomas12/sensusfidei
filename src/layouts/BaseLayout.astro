---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set on article pages so the <title> doesn't duplicate the site name twice. */
  bare?: boolean;
  /** Absolute or root-relative URL for social share previews (og:image / twitter:image). */
  image?: string;
  /**
   * Extra JSON-LD object(s) for this page (e.g. a BlogPosting on an article
   * page). Rendered in addition to — not instead of — the sitewide WebSite
   * schema below, so a page just adds what's specific to it.
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, bare = false, image, jsonLd } = Astro.props;
const pageTitle = bare ? title : `${title} — Sensus Fidei`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image, Astro.site) : undefined;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Sensus Fidei',
  url: Astro.site?.toString(),
  description:
    'A personal Catholic lifestyle and commentary site — essays on faith, stewardship, family, culture, and vocation.',
};

const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Sensus Fidei" href="/rss.xml" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sensus Fidei" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}

    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}

    <title>{pageTitle}</title>

    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {extraSchemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
