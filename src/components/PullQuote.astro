---
interface Props {
  quote: string;
}

const { quote } = Astro.props;
---

<blockquote class="pull-quote">
  <p>{quote}</p>
</blockquote>

<style>
  .pull-quote {
    margin-block: 2.2rem;
    padding-left: 1.4rem;
    border-left: 3px solid var(--gilt);
  }

  .pull-quote p {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 480;
    font-style: italic;
    font-size: clamp(1.3rem, 3vw, 1.65rem);
    line-height: 1.4;
    color: var(--ink);
  }
</style>
